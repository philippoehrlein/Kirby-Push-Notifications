# Git archive / GitHub release ZIP: exclude dev and tooling, include vendor
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore

# Frontend build (source only; built assets live in assets/)
src/ export-ignore
index.dev.mjs export-ignore
package.json export-ignore
package-lock.json export-ignore
node_modules/ export-ignore

# Docs and internals
docs/ export-ignore