{
  "name": "kirby-push-notifications",
  "version": "1.0.0",
	"description": "Web Push for Kirby: channel-based subscriptions, Panel UI, frontend dialog, hooks and API",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "dev": "npx kirbyup src/index.js --watch",
    "serve": "npx kirbyup serve src/index.js",
    "build": "npx kirbyup src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/**\" --write"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@vitejs/plugin-vue": "^5.1.3",
    "autoprefixer": "^10.4.21",
    "kirbyup": "^3.4.1",
    "kirbyuse": "^1.3.0",
    "prettier": "^3.5.3",
    "vite": "^5.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philippoehrlein/kirby-push-notifications.git"
  },
  "author": "Philipp Oehrlein <github@philippoehrlein.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/philippoehrlein/kirby-push-notifications/issues"
  },
  "homepage": "https://github.com/philippoehrlein/kirby-push-notifications#readme"
}
